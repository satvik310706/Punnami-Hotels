generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING_PROOF       // Reserved, waiting for user screenshot upload
  PENDING_CONFIRMATION // User uploaded proof, waiting for Admin review
  CONFIRMED           // Admin approved
  REJECTED            // Admin rejected
  EXPIRED             // TTL expired without proof upload
  CANCEL_REQUESTED    // Guest requested cancellation
  CANCELLED           // Admin approved cancellation
  POSTPONE_REQUESTED  // Guest requested reschedule
  POSTPONED           // Admin approved reschedule
  REFUNDED            // Refund is completed
  PARTIAL_PAID        // Part payment completed
}

enum BookingSource {
  PUBLIC
  ADMIN
}

enum UserRole {
  USER
  ADMIN
  AGENT
}

enum AccountStatus {
  ACTIVE
  BLOCKED
}

model Hotel {
  id              BigInt     @id @default(autoincrement())
  name            String
  slug            String     @unique
  tagline         String?
  description     String?    @db.Text
  address         String?
  mapUrl          String?
  checkInTime     String     @default("12:00")
  checkOutTime    String     @default("11:00")
  facilities      Json?      // string[]
  policies        Json?      // PolicyItem[]
  galleryImages   Json?      // { url, alt }[]
  coverImageUrl   String?
  isActive        Boolean    @default(true)
  status          PublishStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  roomTypes       RoomType[]
}

model RoomType {
  id               BigInt    @id @default(autoincrement())
  hotelId          BigInt
  hotel            Hotel     @relation(fields: [hotelId], references: [id])
  name             String
  slug             String    @unique
  description      String?   @db.Text
  coverImageUrl    String?
  galleryImages    Json?
  facilities       Json?     // string[]
  highlights       Json?     // { icon, title }[]
  faqs             Json?     // { question, answer }[]
  policies         Json?     // PolicyItem[]
  weekdayPrice     Decimal   @db.Decimal(12,2)
  weekendPrice     Decimal   @db.Decimal(12,2)
  capacityPerRoom  Int
  maxAdults        Int
  maxChildren      Int
  totalInventory   Int
  bookingSlots     Json?     // Array of { title, slotStart, slotEnd } — multiple booking timeslots per room
  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)
  orderPriority    Int       @default(0)
  status           PublishStatus @default(DRAFT)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  inventories      RoomInventory[]
  bookings         Booking[]
}

model RoomInventory {
  id             BigInt    @id @default(autoincrement())
  roomTypeId     BigInt
  roomType       RoomType  @relation(fields: [roomTypeId], references: [id])
  date           DateTime  @db.Date
  slotStart      String    @default("12:00:00")
  slotEnd        String    @default("11:00:00")
  priceOverride  Decimal?  @db.Decimal(12,2)
  totalRooms     Int
  bookedRooms    Int       @default(0)
  reservedRooms  Int       @default(0)
  isClosed       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([roomTypeId, date, slotStart, slotEnd])
  @@index([date])
  @@index([roomTypeId])
}

model Booking {
  id                 BigInt        @id @default(autoincrement())
  publicId           String        @unique    // HTL-20260627-XXXXX
  sequenceId         String?       @unique    // HTL-20260627-ETR-0001
  roomTypeId         BigInt
  roomType           RoomType      @relation(fields: [roomTypeId], references: [id])
  checkInDate        DateTime      @db.Date
  checkOutDate       DateTime      @db.Date
  originalCheckInDate  DateTime?   @db.Date   // Stored on first reschedule, never overwritten
  originalCheckOutDate DateTime?   @db.Date   // Stored on first reschedule, never overwritten
  slotStart          String        @default("12:00:00")
  slotEnd            String        @default("11:00:00")
  totalNights        Int
  roomsBooked        Int           @default(1)
  
  guestName          String
  guestEmail         String
  guestPhone         String
  adultCount         Int           @default(1)
  childCount         Int           @default(0)
  
  subtotalAmount     Decimal       @db.Decimal(12,2)
  couponCode         String?
  discountAmount     Decimal       @db.Decimal(12,2) @default(0)
  gstAmount          Decimal       @db.Decimal(12,2)
  gatewayFee         Decimal       @db.Decimal(12,2) @default(0)
  totalAmount        Decimal       @db.Decimal(12,2)
  paidAmount         Decimal?      @db.Decimal(12,2)
  paymentPercentage  Decimal?      @db.Decimal(5,2)  @default(100.00)
  
  // Manual Payment Proof
  paymentProofUrl    String?
  transactionId      String?
  
  status             BookingStatus @default(PENDING_PROOF)
  source             BookingSource @default(PUBLIC)
  
  ticketPdfUrl       String?
  invoicePdfUrl      String?
  
  aadharEncrypted    String?
  aadharHash         String?
  aadharImageUrl     String?
  passengers         Json?
  
  // Cancellation/Postpone fields
  cancellationReason String?       @db.Text
  cancellationFee    Decimal?      @db.Decimal(12,2)
  refundAmount       Decimal?      @db.Decimal(12,2)
  postponeReason     String?       @db.Text
  postponeNewDate    DateTime?     @db.Date
  
  // Agent Reference
  agentId            BigInt?
  agentCommission    Decimal       @default(0.00) @db.Decimal(12,2)
  agent              User?         @relation("AgentBookings", fields: [agentId], references: [id])

  expiresAt          DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  payments           Payment[]

  @@index([roomTypeId])
  @@index([checkInDate])
  @@index([status])
  @@index([agentId])
  @@index([createdAt])
}

model Coupon {
  id                 BigInt    @id @default(autoincrement())
  code               String    @unique
  discountType       String    // PERCENTAGE | FLAT
  discountValue      Decimal   @db.Decimal(12,2)
  maxDiscount        Decimal?  @db.Decimal(12,2)
  minBookingAmt      Decimal?  @db.Decimal(12,2)
  usageLimit         Int?
  usageCount         Int       @default(0)
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean   @default(true)
  isWeekendOnly      Boolean   @default(false)
  isWeekdayOnly      Boolean   @default(false)
  applicableRoomIds  String?   // Comma-separated roomType IDs or null for ALL
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?
}

model User {
  id                    BigInt        @id @default(autoincrement())
  phone                 String        @unique
  email                 String?
  fullName              String?
  role                  UserRole      @default(USER)
  accountStatus         AccountStatus @default(ACTIVE)
  password              String?
  lastLoginAt           DateTime?
  createdAt             DateTime      @default(now())

  // Agent fields
  commissionPercentage  Decimal       @default(0.00) @db.Decimal(5,2)
  commissionType        String        @default("PERCENTAGE") // PERCENTAGE | FIXED
  commissionFixedAmount Decimal       @default(0.00) @db.Decimal(12,2)
  companyName           String?
  gstNumber             String?
  address               String?
  adminNotes            String?
  whiteLabelEnabled     Boolean       @default(false)

  // Relationships
  agentBookings         Booking[]     @relation("AgentBookings")
}

model Payment {
  id                     String   @id @default(uuid())
  bookingId              BigInt
  booking                Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  merchantTransactionId  String   @unique
  amount                 Float
  status                 String   @default("PENDING") // PENDING, COMPLETED, FAILED
  providerResponse       String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AdminOtp {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
